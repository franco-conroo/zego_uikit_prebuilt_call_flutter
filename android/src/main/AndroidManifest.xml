<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.zegocloud.uikit.call_plugin">

    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <application>
        <receiver android:name=".notification.AcceptReceiver" android:exported="false"/>
        <receiver android:name=".notification.RejectReceiver" android:exported="false"/>
        <receiver android:name=".notification.CancelReceiver" android:exported="false"/>
        <receiver android:name=".notification.ClickReceiver" android:exported="false"/>

        <service
            android:name=".voip.VoipConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService"/>
            </intent-filter>
        </service>

        <activity
            android:name=".voip.ZegoCallIncomingActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleInstance"/>
    </application>

</manifest>
